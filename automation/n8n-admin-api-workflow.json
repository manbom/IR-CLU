    {
      "id": "code-check-secret",
      "name": "بررسی رمز",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        0
      ],
      "parameters": {
        "jsCode": "const query = $json.query || {};\nconst secret = String(query.secret || '');\n\n// این رمز رو با یه رمز قوی و تصادفی جایگزین کن، و همون رو توی کد صفحه‌ی وب هم بذار\nconst ADMIN_PANEL_SECRET = 'PLACEHOLDER_ADMIN_PANEL_SECRET';\n\nreturn [{ json: { valid: secret.length > 0 && secret === ADMIN_PANEL_SECRET } }];"
      }
    },
    {
      "id": "if-secret-valid",
      "name": "رمز درست است؟",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -240,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "respond-unauthorized",
